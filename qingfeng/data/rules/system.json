{
  "version": 1,
  "category": "系统",
  "rules": [
    {
      "id": "user-temp",
      "name": "用户临时文件",
      "category": "系统",
      "description": "当前用户 %TEMP% 下的临时文件；正在被程序占用的文件删除会失败，按失败跳过处理",
      "action": "delete",
      "paths": ["%TEMP%"],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "bleachbit"
    },
    {
      "id": "windows-temp",
      "name": "Windows 系统临时文件",
      "category": "系统",
      "description": "%WINDIR%\\Temp 下的系统级临时文件，部分文件属 SYSTEM，需管理员才能删除",
      "action": "delete",
      "paths": ["%WINDIR%\\Temp"],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": true,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "bleachbit"
    },
    {
      "id": "windows-logs",
      "name": "Windows 日志文件",
      "category": "系统",
      "description": "%WINDIR%\\Logs 下的系统日志（DISM、MoSetup 等；CBS 由独立规则处理，WindowsUpdate 保留给更新机制），保留最近 7 天便于排障",
      "action": "delete",
      "paths": ["%WINDIR%\\Logs"],
      "globs": ["*"],
      "exclude_globs": ["CBS", "WindowsUpdate"],
      "risk": "caution",
      "requires_admin": true,
      "default_enabled": true,
      "min_age_days": 7,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "cbs-log",
      "name": "组件服务日志",
      "category": "系统",
      "description": "%WINDIR%\\Logs\\CBS 下的 CBS 日志与 cab，常堆积到几百 MB；保留最近 7 天便于排障",
      "action": "delete",
      "paths": ["%WINDIR%\\Logs\\CBS"],
      "globs": ["*.log", "*.cab", "*.txt"],
      "exclude_globs": [],
      "risk": "caution",
      "requires_admin": true,
      "default_enabled": true,
      "min_age_days": 7,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "windows-prefetch",
      "name": "预取文件 Prefetch",
      "category": "系统",
      "description": "%WINDIR%\\Prefetch 下的预取文件，删除后程序首次启动会稍慢，系统会自动重建；仅清理 30 天前的旧文件",
      "action": "delete",
      "paths": ["%WINDIR%\\Prefetch"],
      "globs": ["*.pf"],
      "exclude_globs": ["Layout.ini", "ReadyBoot"],
      "risk": "caution",
      "requires_admin": true,
      "default_enabled": false,
      "min_age_days": 30,
      "follow_dirs": false,
      "protected_globs": [],
      "report_note": "",
      "source": "bleachbit"
    },
    {
      "id": "windows-minidump",
      "name": "系统崩溃转储",
      "category": "系统",
      "description": "%WINDIR%\\Minidump 下的蓝屏小转储，排障完毕后可删除，需管理员",
      "action": "delete",
      "paths": ["%WINDIR%\\Minidump"],
      "globs": ["*.dmp"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": true,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "live-kernel-reports",
      "name": "内核实时报告",
      "category": "系统",
      "description": "%WINDIR%\\LiveKernelReports 下的内核错误报告转储，需管理员权限",
      "action": "delete",
      "paths": ["%WINDIR%\\LiveKernelReports"],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "caution",
      "requires_admin": true,
      "default_enabled": false,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "windows-systemtemp",
      "name": "系统服务临时文件",
      "category": "系统",
      "description": "%WINDIR%\\SystemTemp 下系统服务使用的临时文件，需管理员权限",
      "action": "delete",
      "paths": ["%WINDIR%\\SystemTemp"],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": true,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "wer-user",
      "name": "Windows 错误报告（当前用户）",
      "category": "系统",
      "description": "当前用户目录下的 WER 崩溃报告与队列，可安全清理",
      "action": "delete",
      "paths": ["%LOCALAPPDATA%\\Microsoft\\Windows\\WER"],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "wer-system",
      "name": "Windows 错误报告（全机）",
      "category": "系统",
      "description": "%PROGRAMDATA%\\Microsoft\\Windows\\WER 下所有用户的错误报告归档，需管理员",
      "action": "delete",
      "paths": ["%PROGRAMDATA%\\Microsoft\\Windows\\WER"],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": true,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "crash-dumps-user",
      "name": "用户态崩溃转储",
      "category": "系统",
      "description": "%LOCALAPPDATA%\\CrashDumps 下的 .dmp 转储文件，单个常达数百 MB",
      "action": "delete",
      "paths": ["%LOCALAPPDATA%\\CrashDumps"],
      "globs": ["*.dmp", "*.mdmp"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "font-cache",
      "name": "字体缓存",
      "category": "系统",
      "description": "%LOCALAPPDATA%\\Microsoft\\Windows\\Caches 下的字体缓存数据库（*.db），删除后系统会自动重建",
      "action": "delete",
      "paths": ["%LOCALAPPDATA%\\Microsoft\\Windows\\Caches"],
      "globs": ["*.db"],
      "exclude_globs": [],
      "risk": "caution",
      "requires_admin": false,
      "default_enabled": false,
      "min_age_days": 0,
      "follow_dirs": false,
      "protected_globs": [],
      "report_note": "",
      "source": "bleachbit"
    },
    {
      "id": "windows-update-download",
      "name": "Windows 更新下载缓存",
      "category": "系统",
      "description": "%WINDIR%\\SoftwareDistribution\\Download 下已下载的更新包；更稳妥的做法是先停 wuauserv 与 bits 再删",
      "action": "delete",
      "paths": ["%WINDIR%\\SoftwareDistribution\\Download"],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "caution",
      "requires_admin": true,
      "default_enabled": false,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "dism++"
    },
    {
      "id": "delivery-optimization-cache",
      "name": "传递优化缓存",
      "category": "系统",
      "description": "Delivery Optimization 的 P2P 更新缓存，占用可上 GB；删除需管理员/SYSTEM，删后 Windows 会按需重建",
      "action": "delete",
      "paths": [
        "%WINDIR%\\SoftwareDistribution\\DeliveryOptimization",
        "%WINDIR%\\ServiceProfiles\\NetworkService\\AppData\\Local\\Microsoft\\Windows\\DeliveryOptimization\\Cache"
      ],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "caution",
      "requires_admin": true,
      "default_enabled": false,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "thumbnails-cache",
      "name": "缩略图缓存",
      "category": "系统",
      "description": "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer 下的 thumbcache_*.db；清理后资源管理器会自动重建（图标缓存见单独规则）",
      "action": "delete",
      "paths": ["%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer"],
      "globs": ["thumbcache_*.db"],
      "exclude_globs": [],
      "risk": "caution",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "bleachbit"
    },
    {
      "id": "icon-cache",
      "name": "图标缓存",
      "category": "系统",
      "description": "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer 下的 iconcache_*.db；删除后图标可能变白，需重启资源管理器重建，默认关闭",
      "action": "delete",
      "paths": ["%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer"],
      "globs": ["iconcache_*.db"],
      "exclude_globs": [],
      "risk": "caution",
      "requires_admin": false,
      "default_enabled": false,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "bleachbit"
    },
    {
      "id": "inet-cache",
      "name": "旧版 Internet 缓存",
      "category": "系统",
      "description": "%LOCALAPPDATA%\\Microsoft\\Windows\\INetCache 下 IE/WebView 遗留的网页缓存",
      "action": "delete",
      "paths": ["%LOCALAPPDATA%\\Microsoft\\Windows\\INetCache"],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "recycle-bin",
      "name": "回收站",
      "category": "系统",
      "description": "清空回收站；走 winapi 的 SHEmptyRecycleBinW（静默、无确认），默认不勾选，需二次确认",
      "action": "empty_recycle_bin",
      "paths": [],
      "globs": [],
      "exclude_globs": [],
      "risk": "caution",
      "requires_admin": false,
      "default_enabled": false,
      "min_age_days": 0,
      "follow_dirs": false,
      "protected_globs": [],
      "report_note": "清空后不可恢复；建议先确认回收站占用再让用户决定",
      "source": "win32-SHEmptyRecycleBin"
    },
    {
      "id": "windows-old",
      "name": "旧版 Windows 备份 (Windows.old)",
      "category": "系统",
      "description": "C:\\Windows.old 是升级/重装后的旧系统备份，常占 10-30 GB；只报告，引导用户用系统自带入口删除",
      "action": "report",
      "paths": [],
      "globs": [],
      "exclude_globs": [],
      "risk": "advanced",
      "requires_admin": true,
      "default_enabled": false,
      "min_age_days": 0,
      "follow_dirs": false,
      "protected_globs": [],
      "report_note": "设置 > 系统 > 存储 > 临时文件（勾选“以前的 Windows 安装”）或运行 cleanmgr.exe；删除后无法回退到升级前的系统",
      "source": "ms-learn"
    }
  ]
}
