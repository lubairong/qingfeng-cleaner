{
  "version": 1,
  "category": "隐私痕迹",
  "rules": [
    {
      "id": "recent-files",
      "name": "最近使用的文件记录",
      "category": "隐私痕迹",
      "description": "%APPDATA%\\Microsoft\\Windows\\Recent 下的 .lnk 快捷方式记录；清理会重置快速访问的固定项",
      "action": "delete",
      "paths": ["%APPDATA%\\Microsoft\\Windows\\Recent"],
      "globs": ["*.lnk"],
      "exclude_globs": [],
      "risk": "advanced",
      "requires_admin": false,
      "default_enabled": false,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "bleachbit:windows_explorer"
    },
    {
      "id": "jump-lists",
      "name": "任务栏跳转列表",
      "category": "隐私痕迹",
      "description": "AutomaticDestinations / CustomDestinations 跳转列表（含最近打开的文件名与路径），属隐私数据",
      "action": "delete",
      "paths": [
        "%APPDATA%\\Microsoft\\Windows\\Recent\\AutomaticDestinations",
        "%APPDATA%\\Microsoft\\Windows\\Recent\\CustomDestinations"
      ],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "advanced",
      "requires_admin": false,
      "default_enabled": false,
      "min_age_days": 0,
      "follow_dirs": false,
      "protected_globs": [],
      "report_note": "",
      "source": "bleachbit:windows_explorer"
    },
    {
      "id": "clipboard-history",
      "name": "剪贴板历史",
      "category": "隐私痕迹",
      "description": "Win+V 剪贴板历史数据库；删除后历史清空，需重启资源管理器或注销生效",
      "action": "delete",
      "paths": ["%LOCALAPPDATA%\\Microsoft\\Windows\\Clipboard"],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "advanced",
      "requires_admin": false,
      "default_enabled": false,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "notification-db",
      "name": "通知中心历史",
      "category": "隐私痕迹",
      "description": "%LOCALAPPDATA%\\Microsoft\\Windows\\Notifications 下的通知数据库，含历史通知内容",
      "action": "delete",
      "paths": ["%LOCALAPPDATA%\\Microsoft\\Windows\\Notifications"],
      "globs": ["*.db", "*.db-wal", "*.db-shm"],
      "exclude_globs": [],
      "risk": "advanced",
      "requires_admin": false,
      "default_enabled": false,
      "min_age_days": 0,
      "follow_dirs": false,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "chromium-browsing-history",
      "name": "Edge/Chrome 浏览记录（进阶）",
      "category": "隐私痕迹",
      "description": "删除 History/Top Sites/Visited Links/Favicons。默认关闭：仅删浏览记录，绝不触碰 Login Data / Cookies / Bookmarks / Local State",
      "action": "delete",
      "paths": [
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\History",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\History-journal",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Visited Links",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Top Sites",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Favicons",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\History",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\History-journal",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Visited Links",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Top Sites",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Favicons"
      ],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "advanced",
      "requires_admin": false,
      "default_enabled": false,
      "min_age_days": 0,
      "follow_dirs": false,
      "protected_globs": ["Login Data", "Cookies", "Bookmarks", "Local State", "Web Data", "Preferences"],
      "report_note": "",
      "source": "bleachbit:chromium"
    },
    {
      "id": "activity-timeline",
      "name": "活动时间线记录（高级）",
      "category": "隐私痕迹",
      "description": "%LOCALAPPDATA%\\ConnectedDevicesPlatform 下各设备目录中的 ActivitiesCache 数据库（仅时间线数据库文件），默认关闭",
      "action": "delete",
      "paths": ["%LOCALAPPDATA%\\ConnectedDevicesPlatform"],
      "globs": ["ActivitiesCache.db", "ActivitiesCache.db-wal", "ActivitiesCache.db-shm"],
      "exclude_globs": [],
      "risk": "advanced",
      "requires_admin": false,
      "default_enabled": false,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "firefox-form-history",
      "name": "Firefox 表单历史（高级）",
      "category": "隐私痕迹",
      "description": "Firefox 保存的搜索框/表单输入历史数据库，默认关闭",
      "action": "delete",
      "paths": ["%APPDATA%\\Mozilla\\Firefox\\Profiles\\*\\formhistory.sqlite"],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "advanced",
      "requires_admin": false,
      "default_enabled": false,
      "min_age_days": 0,
      "follow_dirs": false,
      "protected_globs": [],
      "report_note": "",
      "source": "bleachbit"
    }
  ]
}
