{
  "version": 1,
  "category": "浏览器",
  "rules": [
    {
      "id": "edge-cache",
      "name": "Edge 浏览器缓存",
      "category": "浏览器",
      "description": "只清 Edge 的页面/代码/GPU/着色器/Service Worker 缓存，不动密码、书签、Cookie、历史；建议先完全退出 Edge",
      "action": "delete",
      "paths": [
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Cache",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Code Cache",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\GPUCache",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\ShaderCache",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\GrShaderCache",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\DawnCache",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\DawnGraphiteCache",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\DawnWebGPUCache",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Service Worker\\CacheStorage",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Service Worker\\ScriptCache",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\ShaderCache",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\GrShaderCache",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\GPUPersistentCache",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\GraphiteDawnCache",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\component_crx_cache",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\extensions_crx_cache"
      ],
      "globs": ["*"],
      "exclude_globs": ["*Cookies*", "*Login Data*", "*Local State*"],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": ["Cookies", "Login Data", "Bookmarks", "Local State", "History"],
      "report_note": "",
      "source": "bleachbit:chromium + winapp2.ini"
    },
    {
      "id": "chrome-cache",
      "name": "Chrome 浏览器缓存",
      "category": "浏览器",
      "description": "只清 Chrome 的页面/代码/GPU/着色器/Service Worker 缓存，不动密码、书签、Cookie、历史；建议先完全退出 Chrome",
      "action": "delete",
      "paths": [
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Cache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Code Cache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\GPUCache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\ShaderCache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\GrShaderCache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\DawnCache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\DawnGraphiteCache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\DawnWebGPUCache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Service Worker\\CacheStorage",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Service Worker\\ScriptCache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\ShaderCache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\GrShaderCache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\GPUPersistentCache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\GraphiteDawnCache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\component_crx_cache",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\extensions_crx_cache"
      ],
      "globs": ["*"],
      "exclude_globs": ["*Cookies*", "*Login Data*", "*Local State*"],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": ["Cookies", "Login Data", "Bookmarks", "Local State", "History"],
      "report_note": "",
      "source": "bleachbit:chromium + winapp2.ini"
    },
    {
      "id": "firefox-cache",
      "name": "Firefox 浏览器缓存",
      "category": "浏览器",
      "description": "Firefox 每个 profile 的网络缓存 cache2、启动缓存、着色器缓存与崩溃转储；不动 places.sqlite/cookies.sqlite/logins.json",
      "action": "delete",
      "paths": [
        "%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles\\*\\cache2",
        "%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles\\*\\startupCache",
        "%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles\\*\\shader-cache",
        "%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles\\*\\thumbnails",
        "%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles\\*\\crashes",
        "%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles\\*\\minidumps",
        "%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles\\*\\datareporting"
      ],
      "globs": ["*"],
      "exclude_globs": ["*.sqlite", "logins.json", "key4.db", "*.jsonlz4"],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": ["places.sqlite", "cookies.sqlite", "logins.json", "key4.db", "prefs.js"],
      "report_note": "",
      "source": "bleachbit:firefox"
    },
    {
      "id": "chromium-crashpad",
      "name": "Chromium 内核崩溃报告",
      "category": "浏览器",
      "description": "Edge/Chrome 的 Crashpad 崩溃转储与 .dmp，属诊断数据，可清理",
      "action": "delete",
      "paths": [
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\Crashpad",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\Crash Reports",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\Crashpad",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\Crash Reports"
      ],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "bleachbit:chromium"
    },
    {
      "id": "edge-webview-cache",
      "name": "Edge WebView2 缓存",
      "category": "浏览器",
      "description": "使用 Edge WebView2 的应用（如新版 Outlook、小组件）产生的网页缓存",
      "action": "delete",
      "paths": [
        "%LOCALAPPDATA%\\Microsoft\\EdgeWebView\\EBWebView\\Default\\Cache",
        "%LOCALAPPDATA%\\Microsoft\\EdgeWebView\\EBWebView\\Default\\Code Cache",
        "%LOCALAPPDATA%\\Microsoft\\EdgeWebView\\EBWebView\\Default\\GPUCache"
      ],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "opera-cache",
      "name": "Opera 网页缓存",
      "category": "浏览器",
      "description": "Opera 浏览器（若已安装）的 Cache / Code Cache / GPUCache 缓存目录；不存在时自动跳过",
      "action": "delete",
      "paths": [
        "%APPDATA%\\Opera Software\\Opera Stable\\Cache",
        "%APPDATA%\\Opera Software\\Opera Stable\\Code Cache",
        "%APPDATA%\\Opera Software\\Opera Stable\\GPUCache"
      ],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "bleachbit"
    }
  ]
}
