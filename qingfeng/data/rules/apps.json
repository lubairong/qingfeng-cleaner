{
  "version": 1,
  "category": "应用",
  "rules": [
    {
      "id": "teams-new-cache",
      "name": "新版 Teams 缓存",
      "category": "应用",
      "description": "MSIX 版 Teams（MSTeams_8wekyb3d8bbwe）的页面/代码/GPU 缓存、Service Worker 与日志；不含登录状态与未发送内容，不动聊天记录",
      "action": "delete",
      "paths": [
        "%LOCALAPPDATA%\\Packages\\MSTeams_8wekyb3d8bbwe\\LocalCache\\Microsoft\\MSTeams\\Cache",
        "%LOCALAPPDATA%\\Packages\\MSTeams_8wekyb3d8bbwe\\LocalCache\\Microsoft\\MSTeams\\Code Cache",
        "%LOCALAPPDATA%\\Packages\\MSTeams_8wekyb3d8bbwe\\LocalCache\\Microsoft\\MSTeams\\GPUCache",
        "%LOCALAPPDATA%\\Packages\\MSTeams_8wekyb3d8bbwe\\LocalCache\\Microsoft\\MSTeams\\Service Worker",
        "%LOCALAPPDATA%\\Packages\\MSTeams_8wekyb3d8bbwe\\LocalCache\\Microsoft\\MSTeams\\logs"
      ],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "ms-learn:teams-vdi + winapp2.ini"
    },
    {
      "id": "teams-classic-cache",
      "name": "经典版 Teams 缓存",
      "category": "应用",
      "description": "经典版 Teams（%APPDATA%\\Microsoft\\Teams）的浏览器内核缓存、Service Worker、日志与 tmp；不含登录状态与未发送内容",
      "action": "delete",
      "paths": [
        "%APPDATA%\\Microsoft\\Teams\\Cache",
        "%APPDATA%\\Microsoft\\Teams\\Code Cache",
        "%APPDATA%\\Microsoft\\Teams\\GPUCache",
        "%APPDATA%\\Microsoft\\Teams\\Service Worker",
        "%APPDATA%\\Microsoft\\Teams\\logs",
        "%APPDATA%\\Microsoft\\Teams\\tmp"
      ],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "wechat-cache",
      "name": "微信缓存（经典版目录）",
      "category": "应用",
      "description": "仅清 %USERPROFILE%\\Documents\\WeChat Files\\<账号>\\FileStorage\\Cache 缓存目录，不动聊天记录/图片/视频/文件",
      "action": "delete",
      "paths": ["%USERPROFILE%\\Documents\\WeChat Files\\*\\FileStorage\\Cache"],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "caution",
      "requires_admin": false,
      "default_enabled": false,
      "min_age_days": 1,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini + researcher"
    },
    {
      "id": "discord-cache",
      "name": "Discord 缓存",
      "category": "应用",
      "description": "%APPDATA%\\discord 下的 Cache / Code Cache / GPUCache / blob_storage / logs",
      "action": "delete",
      "paths": [
        "%APPDATA%\\discord\\Cache",
        "%APPDATA%\\discord\\Code Cache",
        "%APPDATA%\\discord\\GPUCache",
        "%APPDATA%\\discord\\blob_storage",
        "%APPDATA%\\discord\\logs"
      ],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "bleachbit:discord"
    },
    {
      "id": "vscode-cache",
      "name": "VS Code 缓存",
      "category": "应用",
      "description": "%APPDATA%\\Code 下的 Cache / Code Cache / GPUCache / CachedData / logs；不动用户 settings.json 与扩展",
      "action": "delete",
      "paths": [
        "%APPDATA%\\Code\\Cache",
        "%APPDATA%\\Code\\Code Cache",
        "%APPDATA%\\Code\\GPUCache",
        "%APPDATA%\\Code\\CachedData",
        "%APPDATA%\\Code\\logs"
      ],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "bleachbit:vscode"
    },
    {
      "id": "steam-htmlcache",
      "name": "Steam 网页缓存",
      "category": "应用",
      "description": "%LOCALAPPDATA%\\Steam\\htmlcache 下的内嵌浏览器缓存（不含游戏本体与 shadercache；未安装 Steam 时自动跳过）",
      "action": "delete",
      "paths": ["%LOCALAPPDATA%\\Steam\\htmlcache"],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "office-filecache",
      "name": "Office 文档缓存",
      "category": "应用",
      "description": "Office 2013/2016+ 的 OfficeFileCache（文档流式缓存），关闭 Office 后清理最安全",
      "action": "delete",
      "paths": [
        "%LOCALAPPDATA%\\Microsoft\\Office\\16.0\\OfficeFileCache",
        "%LOCALAPPDATA%\\Microsoft\\Office\\15.0\\OfficeFileCache"
      ],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 1,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "onedrive-logs",
      "name": "OneDrive 日志",
      "category": "应用",
      "description": "OneDrive 同步客户端日志（不影响云端与本地文件）",
      "action": "delete",
      "paths": [
        "%LOCALAPPDATA%\\Microsoft\\OneDrive\\logs",
        "%LOCALAPPDATA%\\Microsoft\\OneDrive\\setup\\logs"
      ],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "dingtalk-cache",
      "name": "钉钉缓存",
      "category": "应用",
      "description": "钉钉客户端（若已安装）的网页缓存、脚本缓存与 GPU 缓存；不存在时自动跳过",
      "action": "delete",
      "paths": [
        "%APPDATA%\\DingTalk\\Cache",
        "%APPDATA%\\DingTalk\\Code Cache",
        "%APPDATA%\\DingTalk\\GPUCache"
      ],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "adobe-media-cache",
      "name": "Adobe 媒体缓存",
      "category": "应用",
      "description": "Adobe 系列软件（Premiere/AE 等）的媒体缓存文件；请先关闭 Premiere/AE 再清理",
      "action": "delete",
      "paths": ["%LOCALAPPDATA%\\Adobe\\Common\\Media Cache Files"],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "caution",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 1,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "java-webstart-cache",
      "name": "Java WebStart 缓存",
      "category": "应用",
      "description": "Java 部署缓存（下次启动 Java 程序会重新下载）",
      "action": "delete",
      "paths": [
        "%LOCALAPPDATA%\\Sun\\Java\\Deployment\\cache",
        "%LOCALAPPDATA%\\Oracle\\Java\\Deployment\\cache"
      ],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "caution",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    },
    {
      "id": "npm-cache",
      "name": "npm 缓存",
      "category": "应用",
      "description": "%LOCALAPPDATA%\\npm-cache 下的 npm 包缓存；内网/离线环境慎用，之后首次安装会重新下载（仅清理 7 天前的缓存）",
      "action": "delete",
      "paths": ["%LOCALAPPDATA%\\npm-cache\\_cacache"],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "caution",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 7,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "bleachbit"
    },
    {
      "id": "pip-cache",
      "name": "pip 缓存",
      "category": "应用",
      "description": "%LOCALAPPDATA%\\pip\\Cache 下的 Python 包缓存；内网/离线环境慎用，之后首次安装会重新下载（仅清理 7 天前的缓存）",
      "action": "delete",
      "paths": ["%LOCALAPPDATA%\\pip\\Cache"],
      "globs": ["*"],
      "exclude_globs": [],
      "risk": "caution",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 7,
      "follow_dirs": true,
      "protected_globs": [],
      "report_note": "",
      "source": "bleachbit"
    },
    {
      "id": "zoom-logs",
      "name": "Zoom 日志",
      "category": "应用",
      "description": "Zoom 客户端（若已安装）的运行日志（不影响会议与录制文件；不存在时自动跳过）",
      "action": "delete",
      "paths": ["%APPDATA%\\Zoom\\logs"],
      "globs": ["*.log"],
      "exclude_globs": [],
      "risk": "safe",
      "requires_admin": false,
      "default_enabled": true,
      "min_age_days": 0,
      "follow_dirs": false,
      "protected_globs": [],
      "report_note": "",
      "source": "winapp2.ini"
    }
  ]
}
